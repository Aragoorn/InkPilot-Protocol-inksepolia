# Copy to .env (never commit .env). Ink Sepolia testnet only.
#
# --- Deployment (used by deploy.sh and the keeper) -------------------------
# Throwaway TESTNET deployer key only (0x + 64 hex). Never use a key that holds real funds.
PRIVATE_KEY=
# Public Ink Sepolia RPC for deploy.sh / keeper (server-side). Do not use keyed RPCs in VITE_* vars.
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com

# Optional deploy overrides. Leave ASSET and POOL empty to deploy TestUSDC + DemoTydroPool.
ASSET=
POOL=
# Timelock proposer/canceller/executor and guardian. Defaults are testnet placeholders if unset.
TIMELOCK_PROPOSER=
GUARDIAN=
# Optional timelock delay in seconds (minimum 172800 = 48h).
TIMELOCK_DELAY=

# --- Written by deploy.sh after a successful deploy (read by the web app) --
VITE_PILOT_FACTORY=
VITE_PILOT_POOL=
VITE_PILOT_ASSET=
VITE_PILOT_TIMELOCK=
VITE_PILOT_ACCOUNT_IMPL=
VITE_PILOT_FACTORY_IMPL=
VITE_PILOT_DEPLOY_BLOCK=
VITE_PILOT_FAUCET=false
VITE_PILOT_DEMO_POOL=false

# Optional public RPC override for the browser. Must be a public https URL (VITE_* ships to clients).
VITE_INK_SEPOLIA_RPC_URL=

# --- Optional: keeper (gas-only key, never a user key) ---------------------
KEEPER_PRIVATE_KEY=
KEEPER_INTERVAL_SECONDS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
